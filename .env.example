# ─────────────────────────────────────────────────────────────────────────────
# IIIAK client environment — copy to .env and fill real values.
# NEVER commit .env (gitignored). All vars are VITE_-prefixed (client-exposed).
# ─────────────────────────────────────────────────────────────────────────────

# Firebase (client) — all six are REQUIRED (validated at startup,
# see src/lib/firebaseConfig.js → FIREBASE_ENV_VARS)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Supabase (fallback auth/OTP flows)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_EMAIL_OTP=false

# AI Providers (SERVER-ONLY — never prefix with VITE_ to prevent public JS leaks!)
# Used by Vercel serverless functions / Netlify functions
GEMINI_API_KEY=your-primary-gemini-key
GEMINI_BACKUP_KEYS=backup-key-1,backup-key-2
ZAI_API_KEY=your-zai-key
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key
APMIX_KEY=your-apmix-key

# API endpoints
VITE_FUNCTIONS_BASE_URL=https://your-functions-base
VITE_BASE44_APP_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram bot (SERVER-ONLY — never prefix with VITE_, never commit real values)
# ─────────────────────────────────────────────────────────────────────────────
# Rotate the token via @BotFather if it was ever exposed. The webhook refuses
# every update (HTTP 503) when TELEGRAM_WEBHOOK_SECRET is missing.
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
ALPHA_TELEGRAM_CHAT_ID=000000000
TELEGRAM_BOT_USERNAME=black_fighters_bot
APP_BASE_URL=https://blackfighters.site
# Comma-separated admin allowlist for bot admin actions (defaults to the owner).
ADMIN_EMAILS=owner@example.com
# Firebase service account for server-side Firestore/Auth access.
FIREBASE_SERVICE_ACCOUNT_JSON=

