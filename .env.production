# Server calls default to same-origin /api, which is served by this very project and
# was verified live (POST /api/certificates -> 200). The dedicated API host
# (api.blackfighters.site) is proxied through Cloudflare and was still running an
# older router that 404'd five Telegram routes, so pointing the client there made
# linking, the Mini App and certificate calls fail in production.
#
# To switch back once that host is redeployed and healthy, restore:
# VITE_FUNCTIONS_BASE_URL=https://api.blackfighters.site/api
VITE_FUNCTIONS_BASE_URL=
