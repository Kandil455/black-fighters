{
  "name": "Question",
  "type": "object",
  "properties": {
    "quiz_id": {
      "type": "string"
    },
    "question_text": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "correct_option_index": {
      "type": "number",
      "default": 0
    },
    "explanation": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "additionalProperties": true
}