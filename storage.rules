rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'ibrahimkandil000@gmail.com';
    }

    function isSupportedMedia() {
      return request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|video/(mp4|webm|quicktime)|audio/mpeg|application/pdf)');
    }

    function safeName() {
      return request.resource.name.matches('[A-Za-z0-9._\\-]{1,120}');
    }

    // Per-user sandbox: users may only write under their own uid folder.
    // Public read is intentional (served through CDN/average image delivery).
    match /uploads/{userId}/{path=**} {
      allow read: if true;
      allow create: if (isAdmin() || (isAuthed() && request.auth.uid == userId))
        && request.resource.size <= 25 * 1024 * 1024
        && isSupportedMedia()
        && safeName();
      allow update, delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
